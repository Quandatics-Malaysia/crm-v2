# Public demo deployment. Copy to `.env.demo` on the demo host and replace every
# `change_me` value with a freshly generated secret. Never commit `.env.demo`.

COMPOSE_PROJECT_NAME=hyphen-crm-demo

# Cloudflare Tunnel terminates TLS and forwards to 127.0.0.1:8081.
DOMAIN=demo.hyphen-solution.com
BETTER_AUTH_URL=https://demo.hyphen-solution.com
APP_URL=https://demo.hyphen-solution.com
CADDY_HOST_PORT=8081
CADDY_BIND_HOST=0.0.0.0
DB_HOST_PORT=5433

POSTGRES_PASSWORD=change_me_postgres
CRM_APP_PASSWORD=change_me_crm_app
BETTER_AUTH_SECRET=change_me_better_auth

# Vendor-issued deployment control identity; never reuse production/staging.
DEPLOYMENT_ID=11111111-1111-4111-8111-111111111113
AGENT_WEB_SECRET=change_me_to_fresh_43_character_base64url_secret
VENDOR_ENTITLEMENT_TRUST_SET=change_me_vendor_issued_json
APPLICATION_VERSION=0.1.0
MIGRATION_VERSION=0067

# Public-demo identity and fictional regional dataset.
DEMO_MODE=true
SEED_SAMPLE_DATA=true
DEMO_TENANT_ID=demo-entity
DEMO_TENANT_NAME=Gulf Commerce Demo
DEMO_CURRENCY=AED
DEMO_TAX_NAME=VAT 5%
DEMO_TAX_RATE=5.000

# Admin credentials stay private. The viewer login can be shared with prospects.
PLATFORM_MASTER_EMAIL=master@hyphen-solution.com
PLATFORM_MASTER_PASSWORD=change_me_private_master
SEED_SAMPLE_PASSWORD=change_me_shareable_viewer

# Email/password only for the first public demo. SSO stays intentionally unset.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
BOOTSTRAP_OWNER_EMAIL=
ACME_EMAIL=

# No off-box backup target for fictional demo data.
BACKUP_RSYNC_TARGET=
