# ─── Database ────────────────────────────────────────────────────────────────
# App connection (RLS-enforced crm_app role in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
# Privileged connection for migrations + seed (superuser, bypasses RLS).
# In Docker the migrate job uses this; the web app uses DATABASE_URL (crm_app).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/crm

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-please
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Microsoft Entra ID (single-tenant app registration) ─────────────────────
# Redirect URI to register in Azure:
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/microsoft-entra-id
# MICROSOFT_TENANT_ID = your directory (tenant) GUID for single-tenant.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ─── First-login bootstrap ───────────────────────────────────────────────────
# The first user to sign in (or one matching this email) becomes Owner of the
# seeded entity.
BOOTSTRAP_OWNER_EMAIL=

# ─── Demo admin (created by `npm run db:seed`) ───────────────────────────────
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=Password123!

# ─── File storage ────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads