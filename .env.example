# ─── Database ────────────────────────────────────────────────────────────────
# App connection: the RLS-enforced, NON-privileged crm_app role. The app MUST
# connect as this role — a superuser/BYPASSRLS role silently disables tenant
# isolation (instrumentation.ts refuses to boot in that case).
# crm_app is created by db:setup (db/sql/rls.sql); its password is CRM_APP_PASSWORD.
DATABASE_URL=postgres://crm_app:change_me_crm_app@localhost:5432/crm
# Privileged connection for migrations + seed (superuser, bypasses RLS).
# In Docker the migrate job uses this; the web app uses DATABASE_URL (crm_app).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/crm

# Passwords — REQUIRED in production (no insecure defaults; docker-compose fails
# fast if unset). The migrate job sets the crm_app role password to CRM_APP_PASSWORD.
POSTGRES_PASSWORD=postgres
CRM_APP_PASSWORD=change_me_crm_app

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -base64 32
# The app refuses to boot in production if this is left at the dev default.
BETTER_AUTH_SECRET=dev-secret-change-me-please
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Microsoft Entra ID (single-tenant app registration) ─────────────────────
# Register EXACTLY this redirect URI in Azure (must match the code's callback):
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/microsoft-entra-id
# MICROSOFT_TENANT_ID = your directory (tenant) GUID. Required when Microsoft
# sign-in is configured — "common" is rejected at boot (accepts any directory).
MICROSOFT_CLIENT_ID=bb6e92e4-571b-4a83-8026-66e1211fee73
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ─── First-login bootstrap ───────────────────────────────────────────────────
# The first user to sign in (or one matching this email) becomes Owner of the
# seeded entity.
BOOTSTRAP_OWNER_EMAIL=

# ─── Demo admin (created by `npm run db:seed`) ───────────────────────────────
# DEMO_ADMIN_PASSWORD is MANDATORY in production and must NOT be the default
# below — the seed refuses to create a default-credentials superadmin in prod.
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=Password123!

# ─── File storage ────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
