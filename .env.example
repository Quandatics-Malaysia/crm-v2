# Production Compose template. Copy to .env, replace every change_me value,
# and keep the resulting file mode 600. Never commit the populated file.
DOMAIN=crm.example.com
ACME_EMAIL=ops@example.com
BETTER_AUTH_URL=https://crm.example.com
APP_URL=https://crm.example.com

POSTGRES_PASSWORD=change_me_postgres
CRM_APP_PASSWORD=change_me_crm_app
BETTER_AUTH_SECRET=change_me_run_openssl_rand_base64_32
PLATFORM_MASTER_EMAIL=owner@example.com
PLATFORM_MASTER_PASSWORD=change_me_strong_platform_password

# Vendor-issued deployment identity and public signing trust set. Generate the
# shared agent/web secret with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DEPLOYMENT_ID=
AGENT_WEB_SECRET=
VENDOR_ENTITLEMENT_TRUST_SET=

# Immutable metadata for this exact image/release. MIGRATION_VERSION must equal
# the latest migration bundled with the image and actually applied to its DB.
APPLICATION_VERSION=0.1.0
MIGRATION_VERSION=0067

SEED_SAMPLE_DATA=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
BOOTSTRAP_OWNER_EMAIL=
BACKUP_RSYNC_TARGET=
