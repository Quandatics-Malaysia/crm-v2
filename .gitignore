# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example
!.env.demo.example

# local file storage (uploads)
var/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
.superpowers/
.worktrees/

# scratch / throwaway DB + debug scripts
_*.cjs
_*.mjs

# CodeGraph local index (per-developer tooling)
/.codegraph
