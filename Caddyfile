:8081 {
	encode gzip zstd

	request_body {
		max_size 16MB
	}

	@internal_deployment path /api/internal/deployment/*
	route {
		respond @internal_deployment 404
		reverse_proxy web:3000 {
			transport http {
				dial_timeout 10s
				response_header_timeout 30s
			}
		}
	}

	@quotation_preview {
		path_regexp quotation_preview ^/quotations/[^/]+/preview$
	}
	@not_quotation_preview {
		not path_regexp quotation_preview ^/quotations/[^/]+/preview$
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	header @not_quotation_preview {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
	}
	header @quotation_preview {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
	}
}
