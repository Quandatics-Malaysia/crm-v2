# ─── Database ────────────────────────────────────────────────────────────────
# App connection: the RLS-enforced, NON-privileged crm_app role. The app MUST
# connect as this role — a superuser/BYPASSRLS role silently disables tenant
# isolation (instrumentation.ts refuses to boot in that case).
# crm_app is created by db:setup (db/sql/rls.sql); its password is CRM_APP_PASSWORD.
DATABASE_URL=postgres://crm_app:change_me_crm_app@localhost:5432/crm
# Privileged connection for migrations + seed (superuser, bypasses RLS).
# In Docker the migrate job uses this; the web app uses DATABASE_URL (crm_app).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/crm

# Passwords — REQUIRED in production (no insecure defaults; docker-compose fails
# fast if unset). The migrate job sets the crm_app role password to CRM_APP_PASSWORD.
POSTGRES_PASSWORD=postgres
CRM_APP_PASSWORD=change_me_crm_app

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -base64 32
# The app refuses to boot in production if this is left at the dev default.
BETTER_AUTH_SECRET=dev-secret-change-me-please
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Public-only, versioned Ed25519 trust set used to verify vendor entitlement leases.
# Never place vendor signing private key material in the web environment.
VENDOR_ENTITLEMENT_TRUST_SET=

# Machine-only deployment agent boundary. Never use NEXT_PUBLIC_ names.
# DEPLOYMENT_ID must be a canonical lower-case UUID. AGENT_WEB_SECRET is the
# canonical base64url encoding of exactly 32 random bytes (no padding).
DEPLOYMENT_ID=11111111-1111-4111-8111-111111111111
AGENT_WEB_SECRET=change_me_to_43_character_base64url_secret
# Immutable image SemVer and migration version actually applied to this DB.
APPLICATION_VERSION=0.1.0
MIGRATION_VERSION=0067

# ─── Microsoft Entra ID (single-tenant app registration) ─────────────────────
# Register EXACTLY this redirect URI in Azure (must match the code's callback):
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/microsoft-entra-id
# MICROSOFT_TENANT_ID = your directory (tenant) GUID. Required when Microsoft
# sign-in is configured — "common" is rejected at boot (accepts any directory).
MICROSOFT_CLIENT_ID=bb6e92e4-571b-4a83-8026-66e1211fee73
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ─── First-login bootstrap ───────────────────────────────────────────────────
# The first user to sign in (or one matching this email) becomes Owner of the
# seeded entity.
BOOTSTRAP_OWNER_EMAIL=

# ─── Demo admin (created by `npm run db:seed`) ───────────────────────────────
# DEMO_ADMIN_PASSWORD is MANDATORY in production and must NOT be the default
# below — the seed refuses to create a default-credentials superadmin in prod.
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=Password123!

# ─── Demo master switch ──────────────────────────────────────────────────────
# ONE toggle that governs the whole demo, reconciled on every migrate:
#   true  → the Demo Entity is ACTIVE and a rich role-play dataset (accounts,
#           contacts, funnels across every stage, quotations, leads, products,
#           a pending approval…) is seeded onto it.
#   false → the Demo Entity is SUSPENDED (hidden + locked for everyone via the
#           built-in tenant lock) and no sample data is seeded — a real
#           deployment surfaces no demo.
# NB: suspending locks out anyone whose ONLY entity is the demo — flip it to
# false only once you have another entity to work in.
SEED_SAMPLE_DATA=false
# Shared password for the sample logins (manager@/sales1@/sales2@/viewer@demo.local).
# In production a weak/default is refused; leave blank to reuse DEMO_ADMIN_PASSWORD.
SEED_SAMPLE_PASSWORD=

# ─── File storage ────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads

# ─── REST API v1 (`/api/v1/*`) ────────────────────────────────────────────────
# Comma-separated allowlist of origins permitted to call the API cross-origin
# (CORS) — bearer-key auth only, no cookies, so no Allow-Credentials header.
# Defaults to the docs playground's origin if unset.
API_CORS_ORIGINS=https://docs-site-eight-umber.vercel.app

# ─── Backups (docker) ────────────────────────────────────────────────────────
# Optional off-box mirror: after each dump the backup container rsyncs
# /backups to this ssh target (rsync -az --delete). Requires an SSH key +
# known_hosts mounted at /root/.ssh in the backup service (see
# docker-compose.yaml + ops/README.md). Leave empty to skip.
BACKUP_RSYNC_TARGET=
# e.g. BACKUP_RSYNC_TARGET=user@nas:/backups/crm
