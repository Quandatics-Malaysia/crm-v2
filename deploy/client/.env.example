# Copy to .env, replace every CHANGE_ME value, then chmod 0600 .env.
# Syntax is strict data: one allowlisted KEY=value per line; no shell quoting.
COMPOSE_PROJECT_NAME=quandatics-client
DEPLOYMENT_ID=CHANGE_ME_DEPLOYMENT_ID
STORAGE_ID=CHANGE_ME_STABLE_STORAGE_ID
DB_NAME=crm
RELEASE_TAG=v1.2.3
SOURCE_COMMIT_SHA=1111111111111111111111111111111111111111

# Exact release-manifest repositories and immutable digests.
WEB_IMAGE=ghcr.io/super-erp/crm-web@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MIGRATOR_IMAGE=ghcr.io/super-erp/crm-migrator@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
BACKUP_IMAGE=ghcr.io/super-erp/crm-backup@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
AGENT_IMAGE=ghcr.io/super-erp/crm-deployment-agent@sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
POSTGRES_IMAGE=docker.io/library/postgres@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
CADDY_IMAGE=docker.io/library/caddy@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee

POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
CRM_APP_PASSWORD=CHANGE_ME_APPLICATION
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTE_RANDOM_SECRET
BETTER_AUTH_URL=https://crm.example.com
APP_URL=https://crm.example.com
PLATFORM_MASTER_EMAIL=owner@example.com
PLATFORM_MASTER_PASSWORD=CHANGE_ME_PLATFORM_MASTER
BOOTSTRAP_OWNER_EMAIL=owner@example.com
AGENT_WEB_SECRET=CHANGE_ME_AGENT_WEB_SECRET
APPLICATION_VERSION=1.2.3
MIGRATION_VERSION=0069
VENDOR_ENTITLEMENT_TRUST_SET=CHANGE_ME_VENDOR_TRUST_SET
CONTROL_PLANE_URL=https://control.example.com
DEPLOYMENT_ENV=production
INSTALLATION_TOKEN=CHANGE_ME_43_CHARACTER_INSTALLATION_TOKEN
AGENT_VERSION=0.1.0
AGENT_MEMORY_LIMIT=128m

# Host Nginx terminates public TLS on :443 and proxies this loopback port.
GATEWAY_HOST_PORT=8081
DB_HOST_PORT=5433

# Root-owned backup trust anchor and detached signed evidence.
BACKUP_EVIDENCE_FILE=/var/lib/quandatics-client/backup/verified-release.env
BACKUP_EVIDENCE_SIGNATURE_FILE=/var/lib/quandatics-client/backup/verified-release.env.sig
BACKUP_EVIDENCE_PUBLIC_KEY_FILE=/etc/quandatics-client/backup-evidence.pub
BACKUP_EVIDENCE_PUBLIC_KEY_SHA256=CHANGE_ME_64_HEX_PUBLIC_KEY_SHA256
BACKUP_MAX_AGE_SECONDS=86400
DEPLOYMENT_RECORD_FILE=/var/lib/quandatics-client/deployed-release.env

HEALTHCHECK_ATTEMPTS=30
HEALTHCHECK_INTERVAL_SECONDS=2
HEALTHCHECK_TIMEOUT_SECONDS=5
DB_HEALTH_ATTEMPTS=30
DB_HEALTH_INTERVAL_SECONDS=2

# Generated and overwritten by deploy.sh; retained only so standalone
# `docker compose ... config` can validate this example without secrets logic.
DATABASE_ADMIN_URL=DERIVED_BY_DEPLOY
MIGRATOR_DATABASE_URL=DERIVED_BY_DEPLOY
APP_DATABASE_URL=DERIVED_BY_DEPLOY
IMAGE_DIGEST=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
