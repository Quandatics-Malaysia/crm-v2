# Source-free staging profile. Copy to owner-only .env and replace CHANGE_ME values.
COMPOSE_PROJECT_NAME=crm-v2-staging
DEPLOYMENT_ID=CHANGE_ME_STAGING_DEPLOYMENT_ID
STORAGE_ID=quandatics-staging
DB_NAME=crm_staging
RELEASE_TAG=v1.2.14-rc.1
RELEASE_CHANNEL=beta
DEPLOYED_AT=2026-08-12T00:00:00Z
SOURCE_COMMIT_SHA=CHANGE_ME_40_HEX_COMMIT
BETTER_AUTH_URL=https://staging.app.quandatics.com
APP_URL=https://staging.app.quandatics.com
DEPLOYMENT_ENV=staging
GATEWAY_HOST_PORT=8092
DB_HOST_PORT=5434
DB_MEMORY_LIMIT=1g
WEB_MEMORY_LIMIT=768m
AGENT_MEMORY_LIMIT=128m
BACKUP_MEMORY_LIMIT=256m
GATEWAY_MEMORY_LIMIT=128m

# Copy all remaining required keys from .env.example. Use independent staging
# secrets, installation token, storage identity, backup evidence, and digests.
# Every image reference must be immutable repository@sha256:... form.
